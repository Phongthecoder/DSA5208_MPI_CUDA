#!/bin/bash
#PBS -N dsa5208_serial_extended
#PBS -q auto_free
#PBS -l select=1:ncpus=1:mem=2gb
#PBS -l walltime=00:40:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the checkout root or serial/}"
if [[ -f serial/scripts/serial_extended_vanda.pbs ]]; then
    cd serial
fi

compiler="${CXX:-c++}"
build_dir="build/${PBS_JOBID}"
output_dir="results/${PBS_JOBID}"
mkdir -p "$output_dir"
{
    date -u
    printf 'PBS job %s\n' "$PBS_JOBID"
    uname -a
    lscpu
    grep '^Cpus_allowed_list:' /proc/self/status
    "$compiler" --version
    python3 --version
    /usr/bin/time --version
} > "$output_dir/environment.txt"

make BUILD_DIR="$build_dir" CXX="$compiler" all
make BUILD_DIR="$build_dir" CXX="$compiler" check | tee "$output_dir/serial_validation.txt"
python3 scripts/benchmark_extended_serial.py --binary "$build_dir/serial_pf" --output-dir "$output_dir"
